# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_CHEAP=openai/gpt-4o-mini
OPENROUTER_MODEL_STRONG=openai/gpt-4o
# Model that supports OpenRouter multimodal input_audio (see OpenRouter audio docs)
OPENROUTER_MODEL_TRANSCRIPTION=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.15
OPENROUTER_TIMEOUT_S=90
OPENROUTER_MAX_RETRIES=3

# Langfuse (challenge host shown in portal)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://challenges.reply.com/langfuse

# Optional fusion weights (defaults shown)
FUSION_WEIGHT_FRAUD=0.55
FUSION_WEIGHT_ECONOMIC=0.35
FUSION_WEIGHT_CLUSTER=0.10

# Cache directory for normalized tables
DATA_CACHE_DIR=data_cache

# Audio (metadata-only unless transcription explicitly enabled)
ENABLE_AUDIO=false
ENABLE_AUDIO_TRANSCRIPTION=false
AUDIO_TRANSCRIPTION_MAX_BYTES=1200000
AUDIO_TRANSCRIPTION_MAX_FILES=2

# Parallel HTTP workers for specialist + transcription tasks (single pool when transcribing)
LLM_PARALLEL_WORKERS=4

# Challenge session ID prefix (spaces auto-normalized to -)
TEAM_NAME=reply-agent
LANGFUSE_MEDIA_UPLOAD_ENABLED=false
